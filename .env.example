# Brightspace credentials and mode
BRIGHTSPACE_URL=https://www.fanshaweonline.ca/d2l/home
BRIGHTSPACE_USERNAME=
BRIGHTSPACE_PASSWORD=

# Week range (ISO format; leave empty for current week Mon-Sun)
WEEK_START_DATE=
WEEK_END_DATE=

# Output and paths
OUTPUT_FOLDER=/mnt/c/Bin/SideProjs/brightspace-weekly-planner/output
SITE_MAP_PATH=/mnt/c/Bin/SideProjs/brightspace-weekly-planner/output/brightspace_site_map.json

# Auth
AUTH_MODE=persistent_profile
PLAYWRIGHT_PROFILE_DIR=/mnt/c/Bin/SideProjs/brightspace-weekly-planner/.local_browser_profile
PLAYWRIGHT_STORAGE_STATE_PATH=/mnt/c/Bin/SideProjs/brightspace-weekly-planner/secrets/brightspace_storage_state.json

# Browser
HEADLESS=false
BROWSER_SLOW_MO_MS=0
